# Copy to `.env` and adjust. `.env` is git- and docker-ignored.

# HTTP port the API listens on (inside the container always 3001).
PORT=3001

# Bind address. Keep 0.0.0.0 inside Docker.
HOST=0.0.0.0

# Kill switches — "false" disables the component, anything else keeps it on.
ENABLE_HYBRID=true
ENABLE_DEVIL=true

# Evidence-first pipeline (NVIDIA). Never commit real keys — `.env` only.
# Free embedding endpoint model (OpenAI-compatible).
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Next steps (Modal reranker + Nemotron Ultra — wired, snapshot-first by default):
# HTTPS endpoint self-hosting nvidia/llama-nemotron-rerank-1b-v2 on Modal.
# Empty = passthrough fallback (retrieval order kept, -10 confidence).
# Contract: POST { query, passages: [{chunk_id, text}], top_n, model }
#   -> { results: [{chunk_id, score}] } (also accepts bare array, {ranking}, {data}).
MODAL_RERANKER_URL=
MODAL_RERANKER_MODEL=nvidia/llama-nemotron-rerank-1b-v2
MODAL_RERANKER_TIMEOUT_MS=15000
# Final free LLM endpoint producing structured Evidence.
NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
