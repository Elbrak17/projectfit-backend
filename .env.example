# Copy to `.env` and adjust. `.env` is git- and docker-ignored.

# HTTP port the API listens on (inside the container always 3001).
PORT=3001

# Bind address. Keep 0.0.0.0 inside Docker.
HOST=0.0.0.0

# Kill switches — "false" disables the component, anything else keeps it on.
ENABLE_HYBRID=true
ENABLE_DEVIL=true
